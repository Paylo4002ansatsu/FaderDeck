{
  "name": "faderdeck",
  "productName": "FaderDeck",
  "version": "1.0.2",
  "description": "FaderDeck: controlador MIDI customizável com ponte local para a sua DAW",
  "author": "FaderDeck",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "bridge": "node server.cjs",
    "test": "node --test",
    "package:bridge": "node scripts/package-bridge.cjs",
    "update:site-download-version": "node scripts/update-site-download-version.cjs",
    "dist": "electron-builder --mac dmg zip",
    "dist:universal": "electron-builder --mac dmg zip --universal",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@julusian/midi": "^3.5.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.faderdeck",
    "productName": "FaderDeck",
    "asar": true,
    "asarUnpack": [
      "node_modules/@julusian/midi/**/*"
    ],
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "main.js",
      "electron-utils.cjs",
      "server.cjs",
      "server-utils.cjs",
      "bridge/**/*",
      "client/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "FaderDeck-Mac.${ext}",
      "target": ["dmg", "zip"],
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/@julusian/midi/prebuilds/midi-darwin-*/**",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "O FaderDeck usa a rede local para receber os controles do seu celular.",
        "LSUIElement": false
      }
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "FaderDeck-Windows-Setup.exe",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "FaderDeck",
      "contents": [
        { "x": 140, "y": 180 },
        { "x": 400, "y": 180, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
